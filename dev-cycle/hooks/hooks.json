{
  "description": "Dev-cycle review chain: each implementer, spec-reviewer, and code-quality-reviewer stop opens a pending stage; launching the next agent retires it; the orchestrator's turn continues with the stage's mandate while it is pending",
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^(dev-cycle:)?implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/review-chain.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(dev-cycle:)?spec-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/review-chain.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(dev-cycle:)?code-quality-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/review-chain.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|SendMessage)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/review-chain.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/review-chain.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
