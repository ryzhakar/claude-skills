{
  "description": "work-silently re-entry at session start, resume, fork, and after compaction while the project's silence marker exists",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
